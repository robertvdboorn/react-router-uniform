# Uniform Configuration
# Copy this file to .env and fill in your values

# ⚠️ IMPORTANT: These variables are SERVER-SIDE ONLY (not exposed to browser)
# No VITE_ prefix = secure API keys!

# Uniform API Key (starts with "uf...")
# Get this from: https://uniform.app/settings/api-keys
# Required permissions: Read Published Compositions
UNIFORM_API_KEY=your_api_key_here

# Uniform Project ID
# Get this from: https://uniform.app/settings/project
UNIFORM_PROJECT_ID=your_project_id_here

# Uniform API Base URL (optional)
# Use https://uniform.app for US region
# Use https://eu.uniform.app for EU region
UNIFORM_CLI_BASE_URL=https://eu.uniform.app

# Uniform Edge API Base URL (optional)
UNIFORM_CLI_BASE_EDGE_URL=https://eu.uniform.app

# Uniform Preview Secret
# Used to secure preview endpoints
# Can be any string, must match what you configure in Uniform settings
# Development: OK to use 'hello-world' for local testing
# Production: MUST use a strong random secret (min 32 characters)
# Generate: openssl rand -base64 32
UNIFORM_PREVIEW_SECRET=hello-world

# ===================================================================
# Upstash Redis Configuration (Optional in Dev, Required in Production)
# ===================================================================
# Get credentials from: https://console.upstash.com/
# 
# Used for:
# 1. Preview token storage (persistent across server restarts)
# 2. Rate limiting (prevents brute-force attacks)
# 
# Without Redis:
# - Tokens stored in-memory (lost on restart)
# - No rate limiting (security risk in production)
# - Not cluster-safe (tokens don't sync across instances)
#
# Create a free Upstash Redis database:
# 1. Go to https://console.upstash.com/
# 2. Click "Create Database"
# 3. Select region closest to your deployment
# 4. Copy REST API credentials below
# ===================================================================

UPSTASH_REDIS_REST_URL=https://your-redis-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ===================================================================
# Security Configuration (Optional)
# ===================================================================

# Content Security Policy (RECOMMENDED for Uniform Canvas preview)
# CSP provides proper frame-ancestors control for iframe embedding
# The included CSP is already configured for Uniform compatibility
# Recommended: ENABLE_CSP=true
ENABLE_CSP=true

# Custom Allowed Origins for CORS (comma-separated)
# By default allows: Uniform Canvas + same origin
# Add your staging/production domains if needed
# ALLOWED_ORIGINS=https://staging.your-domain.com,https://your-domain.com

# IP Allowlisting (optional, high-security environments only)
# Restricts API access to specific IPs (comma-separated)
# Warning: Not recommended for dynamic IPs, mobile users, or VPNs
# ALLOWED_IPS=1.2.3.4,5.6.7.8

# ===================================================================
# Monitoring & Health Checks
# ===================================================================
# 
# Health Check Endpoint: /api/health
# 
# Returns JSON with service status:
# - Redis connectivity (if configured)
# - Uniform API connectivity
# 
# Use for:
# - Load balancer health checks
# - Uptime monitoring (e.g., Pingdom, UptimeRobot)
# - CI/CD deployment verification
# - Kubernetes liveness/readiness probes
# 
# Example Response:
# {
#   "status": "healthy" | "degraded" | "unhealthy",
#   "timestamp": "2024-01-15T12:00:00.000Z",
#   "services": {
#     "redis": { "status": "ok" },
#     "uniform": { "status": "ok" }
#   }
# }
# ===================================================================
